<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.github.acnxo</groupId>
    <artifactId>sdk-ylmf-open</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>sdk-ylmf-open</name>
    <description>115网盘开放平台OpenAPI软件开发工具包</description>
    <url>https://github.com/acnxo/sdk-ylmf-open</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
        </license>
    </licenses>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Java 版本 -->
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>

        <!-- 依赖版本统一管理 -->
        <autil.version>1.3.0</autil.version>
        <json-jackson.version>1.3.0</json-jackson.version>
        <slf4j-api.version>2.0.18</slf4j-api.version>
        <junit.jupiter.version>6.1.3</junit.jupiter.version>

        <!-- 插件版本统一管理 -->
        <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
        <spotbugs-maven-plugin.version>4.10.4.0</spotbugs-maven-plugin.version>
    </properties>

    <dependencies>
        <!-- ACANX 基础工具库（字符串、集合等通用工具） -->
        <dependency>
            <groupId>com.acanx.util</groupId>
            <artifactId>autil-core</artifactId>
            <version>${autil.version}</version>
        </dependency>

        <!-- ACANX JSON 序列化工具库 -->
        <dependency>
            <groupId>com.acanx.util</groupId>
            <artifactId>json-jackson</artifactId>
            <version>${json-jackson.version}</version>
        </dependency>

        <!-- 日志门面 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j-api.version}</version>
        </dependency>

        <!-- 单元测试 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
            </plugin>
            <!-- 静态代码分析（质量卡点） -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>${spotbugs-maven-plugin.version}</version>
            </plugin>
        </plugins>
    </build>
</project>
